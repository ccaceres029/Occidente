# Opcional. El backend busca primero estas variables y luego el archivo central de MACAOIT.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MACAOIT_SECRETS_PATH=/Users/arturocaceres/Documents/MACAO Solutions DEV/MACAO Tecnico/MACAOIT_LOCAL_SECRETS.env
PORT=3001

# MySQL / Amazon RDS. En producción use un EnvironmentFile fuera de Git.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=dbOccidente
DB_SSL_CA=/var/www/Occidente/shared/rds-ca-global.pem
DB_CONNECTION_LIMIT=8

# Llave aleatoria de 32 bytes en base64 para cifrar la contraseña IMAP/SMTP.
MAIL_CREDENTIALS_KEY=
MAIL_SYNC_INTERVAL_SECONDS=60

# Solo para el primer inicio; retire estas variables cuando el usuario ya exista.
OCCIDENTE_BOOTSTRAP_USERNAME=
OCCIDENTE_BOOTSTRAP_PASSWORD=
OCCIDENTE_BOOTSTRAP_DISPLAY_NAME=Administrador Occidente
OCCIDENTE_BOOTSTRAP_ROLE=ADMIN
