{
  "name": "dmo-bank-occi",
  "version": "0.5.17",
  "private": true,
  "description": "Demo local de automatizacion de afiliaciones AFPC Occidente",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "portal:dev": "PORTAL_MODE=demo pnpm --filter @occi/server exec tsx src/projectPortal/index.ts",
    "portal:start": "node server/dist/projectPortal/index.js",
    "portal:test": "pnpm --filter @occi/server exec tsx --test test/projectPortal.test.ts && node --test portal/calendar.test.mjs",
    "dev": "pnpm --parallel --filter @occi/server --filter @occi/client dev",
    "build": "pnpm --filter @occi/server build && pnpm --filter @occi/client build",
    "build:site": "node scripts/build-site.mjs",
    "test": "pnpm --filter @occi/server test && pnpm --filter @occi/client test",
    "start": "pnpm --filter @occi/server start"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "execa": "^9.6.0"
  }
}
