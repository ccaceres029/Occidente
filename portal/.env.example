# Ejemplo para un servicio separado. No contiene credenciales reales.
# El proceso no carga .env automaticamente: usar EnvironmentFile de systemd.
PORTAL_MODE=mysql
PORTAL_HOST=127.0.0.1
PORTAL_PORT=3012
PORTAL_ORIGIN=https://portal-proyecto.example.com
PORTAL_DB_HOST=YOUR_MYSQL_HOST
PORTAL_DB_PORT=3306
PORTAL_DB_NAME=YOUR_DEDICATED_PORTAL_DATABASE
PORTAL_DB_USER=YOUR_DEDICATED_PORTAL_USER
PORTAL_DB_PASSWORD=SET_OUTSIDE_GIT
PORTAL_DB_SSL_CA=/etc/macao-portal/mysql-ca.pem
# Solo primer arranque. Retirar despues de crear el administrador.
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_NAME=Coordinación MACAO
PORTAL_ADMIN_PASSWORD=SET_OUTSIDE_GIT_MINIMUM_12_CHARACTERS
